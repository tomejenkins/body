# Public application configuration (browser-visible; never use a service-role/secret key).
# Supabase dashboard: Connect / Project URL and API Keys / publishable key.
# Local Next.js and Workers preview: copy this file to .env.local, then set both values.
# Cloudflare: set these in BOTH Build variables and secrets and runtime Variables and Secrets.
# NEXT_PUBLIC_* values are inlined at build time. Changing projects requires a rebuild.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# CLI credentials are separate, shell/secret-store only. Do NOT add values here:
# SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD, SUPABASE_PROJECT_ID
# Never define a NEXT_PUBLIC_* database password or service-role key.
